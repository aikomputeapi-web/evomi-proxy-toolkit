{
  "manifest_version": 2,
  "name": "Proxy Switcher (Auth)",
  "version": "1.0.0",
  "description": "Save, switch, and re-connect authenticated (user:pass) proxies. Paste a proxy string in any common format.",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Proxy Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "proxy-switcher-auth@local.extension",
      "strict_min_version": "91.0"
    }
  }
}
